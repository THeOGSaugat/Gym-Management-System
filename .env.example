# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string from your Neon project.
# Neon dashboard → your project → "Connect" → copy the "Prisma" connection string.
# It should look like:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# App environment. Used to toggle dev-only behavior (verbose errors, etc).
NODE_ENV="development"
