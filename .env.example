# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string from your Neon project.
# Neon dashboard → your project → "Connect" → copy the "Prisma" connection string.
# It should look like:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# App environment. Used to toggle dev-only behavior (verbose errors, etc).
NODE_ENV="development"

# Auth.js session signing secret. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 33
# Use a different value per environment; never reuse the dev value in production.
AUTH_SECRET="replace-with-a-generated-secret"

# Optional. How many reverse proxies you control sit in front of the app
# (Vercel, nginx, a load balancer...). Used to find the real client IP in
# X-Forwarded-For for the per-client login rate limit. Defaults to 1.
# Set to 0 if the app is exposed directly with no proxy in front.
# TRUSTED_PROXY_HOPS="1"
