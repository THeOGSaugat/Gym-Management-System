// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAINER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// One table for every role. Login is identical regardless of role, so a
// single table avoids three separate login paths. Role-specific profile
// data (MemberProfile, TrainerProfile) lives in its own table, one per role.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  // Basic contact info, not identity/auth data — kept on User rather than
  // duplicated per role-profile table, since every role can have a phone.
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberProfile MemberProfile?

  // As the member on their own memberships/payments.
  memberships Membership[] @relation("MemberMemberships")
  payments    Payment[]    @relation("MemberPayments")
  // As the admin who created/recorded them (audit trail, not ownership).
  membershipsCreated Membership[] @relation("MembershipCreatedBy")
  paymentsRecorded   Payment[]    @relation("PaymentRecordedBy")

  attendance         Attendance[] @relation("MemberAttendance")
  attendanceRecorded Attendance[] @relation("AttendanceRecordedBy")

  trainerProfile TrainerProfile?

  // As the member/trainer in an assignment relationship.
  assignmentsAsMember  TrainerAssignment[] @relation("MemberAssignments")
  assignmentsAsTrainer TrainerAssignment[] @relation("TrainerAssignments")
  // As the admin who created the assignment (audit trail, not ownership).
  assignmentsCreated TrainerAssignment[] @relation("AssignmentCreatedBy")

  exercisesCreated Exercise[] @relation("ExerciseCreatedBy")

  // As the member/trainer on a workout plan.
  workoutPlansAsMember  WorkoutPlan[] @relation("MemberWorkoutPlans")
  workoutPlansAsTrainer WorkoutPlan[] @relation("TrainerWorkoutPlans")

  // As the member on their own progress logs, and as whoever recorded one
  // (always the member themself today — see progress.service.ts — but kept
  // separate from ownership for the same reason Payment.recordedByUserId is).
  progressLogs         ProgressLog[] @relation("MemberProgressLogs")
  progressLogsRecorded ProgressLog[] @relation("ProgressLogRecordedBy")

  notifications Notification[] @relation("UserNotifications")

  @@map("users")
}

// Member-specific data. Exists only for users with role = MEMBER — that's
// a service-layer invariant (see member.service.ts), not something the DB
// schema alone enforces, since Prisma doesn't support conditional
// relations based on a sibling column's value.
model MemberProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Human-friendly identifier for front-desk use (e.g. "GYM-000042"),
  // distinct from the internal cuid `id`. Postgres autoincrement handles
  // concurrent creates safely without a custom counter/lock.
  memberNumber Int @unique @default(autoincrement())

  dateOfBirth           DateTime?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // When they joined the gym, which may predate the account record itself
  // (e.g. a backfilled member) — distinct from `createdAt`.
  joinDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("member_profiles")
}

// The catalog of what the gym sells. A Membership is an instance of a
// plan purchased by a member — see the comment there for why plan terms
// are snapshotted onto the Membership rather than read live from here.
model MembershipPlan {
  id           String  @id @default(cuid())
  name         String
  description  String?
  // Duration in days, not months — "add N days" sidesteps the whole class
  // of bug around months of different lengths (a plan starting Jan 31).
  durationDays Int
  // Integer minor units (cents), never a float — money is never stored as
  // a float in this codebase. See Payment.amountMinor for the same rule.
  priceMinor Int
  currency   String  @default("USD")
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@map("membership_plans")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

// A purchased membership. Always a new row per purchase/renewal — never
// edited to extend its own end date — so renewal history is preserved
// (see membership.service.ts). `status` is the last value we computed or
// an admin explicitly set; the *authoritative* answer to "is this active
// right now" is always computed fresh from status + dates (see
// src/lib/membership.ts), the same "derive, don't just trust the stored
// flag" rule as the rest of this codebase's account-status handling.
model Membership {
  id String @id @default(cuid())

  memberId String
  member   User   @relation("MemberMemberships", fields: [memberId], references: [id], onDelete: Cascade)

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(PENDING)

  // Snapshot of the plan's terms at purchase time. If the admin later
  // raises the plan's price, this membership must still show what was
  // actually charged — never join to the live plan for historical display.
  planNameSnapshot   String
  priceMinorSnapshot Int
  currencySnapshot   String

  cancelledAt  DateTime?
  cancelReason String?

  createdByUserId String
  createdBy       User   @relation("MembershipCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([memberId, status])
  @@index([status, endDate])
  @@map("memberships")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
}

// Append-only by design: there is no update/delete surface for a Payment
// anywhere in this codebase. A correction (a bounced cheque, a refund) is
// recorded as its own new row, not an edit to this one — an accounting
// record must never silently change after the fact. See README for what
// that means today (no refund-linkage tooling yet) vs. later.
model Payment {
  id String @id @default(cuid())

  memberId String
  member   User   @relation("MemberPayments", fields: [memberId], references: [id], onDelete: Cascade)

  // Nullable: a payment isn't always tied to a specific membership (could
  // be a one-off charge), but most are.
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id])

  amountMinor Int
  currency    String @default("USD")

  method PaymentMethod
  status PaymentStatus @default(SUCCEEDED)

  // External reference (bank transfer id, receipt number, ...), not a
  // payment-gateway transaction id — there is no gateway integration yet.
  reference String?
  notes     String?

  paidAt DateTime @default(now())

  recordedByUserId String
  recordedBy       User   @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, paidAt])
  @@index([membershipId])
  @@map("payments")
}

enum AttendanceMethod {
  // Self check-in via the member portal's Check In button — the only
  // method actually reachable today.
  MANUAL
  // Reserved, unused: a future QR-code check-in flow calls the exact
  // same attendance.service.ts functions with method: "QR" instead of
  // "MANUAL" — no business-logic changes needed when that's built. See
  // the comment on checkIn() in attendance.service.ts.
  QR
}

// One row per check-in. `recordedByUserId` is always set (to whoever
// performed the action — today, always the member themself) and is
// separate from `method` (how it happened); this keeps "who" and "how"
// independent so a future admin-assisted or QR check-in doesn't need a
// new column, just a different value for each.
//
// Duplicate-checkin prevention is deliberately about *open sessions*,
// not "once per day": a member can check in, check out, and check in
// again later the same day. What's actually disallowed is two
// simultaneously open sessions for the same member — enforced here at
// the service layer (see attendance.service.ts) and, as defense in
// depth against a race between two concurrent requests, by a partial
// unique index added by hand in this model's migration (Prisma's schema
// DSL has no declarative syntax for a partial/filtered unique index):
// CREATE UNIQUE INDEX ... ON attendance (memberId) WHERE checkOutAt IS NULL.
model Attendance {
  id String @id @default(cuid())

  memberId String
  member   User   @relation("MemberAttendance", fields: [memberId], references: [id], onDelete: Cascade)

  // Always set from the server's clock at the moment of the request,
  // never accepted as client input — see checkIn()/checkOut() in
  // attendance.service.ts, whose input types have no date/time field at
  // all for exactly this reason (the same "safe by construction, not
  // just by validation" pattern used for a membership's price).
  checkInAt  DateTime
  checkOutAt DateTime?

  // The calendar day checkInAt falls on, at UTC midnight — computed
  // server-side once at check-in time (see lib/date.ts's startOfDay).
  // Stored redundantly alongside checkInAt so "today's attendance" and
  // date-range history queries can filter/index on a plain date value
  // instead of computing day boundaries in every query.
  attendanceDate DateTime

  method AttendanceMethod @default(MANUAL)

  recordedByUserId String?
  recordedBy       User?   @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance")
}

// Trainer-specific data. Exists only for users with role = TRAINER —
// a service-layer invariant (see trainer.service.ts), same as
// MemberProfile. "Active status" deliberately reuses User.status
// (ACTIVE/SUSPENDED) rather than a second flag here — the same
// activate/deactivate mechanism Phase 2 built for members, not a
// separate concept like "temporarily not accepting new clients."
model TrainerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  specialization  String?
  experienceYears Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trainer_profiles")
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

// A time-bounded member <-> trainer relationship, not a foreign key on
// either User — ending an assignment (removing it, or replacing it with
// a different trainer) never deletes the row, only closes it
// (status: ENDED, endDate set), so "who trained this member, and when"
// survives. See assignment.service.ts: assigning a member who already
// has an active assignment ends the old row and opens a new one in the
// same operation — "assign" and "change trainer" are the same thing
// from the data model's point of view.
//
// At most one ACTIVE assignment per member at a time — enforced here by
// a hand-written partial unique index (Prisma's schema DSL has no
// declarative syntax for one; see this model's migration), the same
// technique Phase 4 used for "at most one open attendance session."
model TrainerAssignment {
  id String @id @default(cuid())

  memberId String
  member   User   @relation("MemberAssignments", fields: [memberId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User   @relation("TrainerAssignments", fields: [trainerId], references: [id], onDelete: Cascade)

  status    AssignmentStatus @default(ACTIVE)
  startDate DateTime         @default(now())
  endDate   DateTime?

  notes String?

  assignedByUserId String
  assignedBy       User   @relation("AssignmentCreatedBy", fields: [assignedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, status])
  @@index([trainerId, status])
  @@map("trainer_assignments")
}

// A shared catalog, not per-trainer data — the same "Bench Press" exists
// once, usable across every workout plan, not re-entered per trainer.
// Admins manage the whole catalog; a trainer can add new entries (the
// library needs to grow as programs get built) but can only edit/
// deactivate ones *they* created — see canEditExercise in policies.ts.
// Deactivating (not deleting) matches every other catalog in this app
// (MembershipPlan): an exercise already used in a workout plan must
// survive, so existing plans keep showing it.
model Exercise {
  id           String  @id @default(cuid())
  name         String
  muscleGroup  String?
  description  String?
  instructions String?
  isActive     Boolean @default(true)

  createdByUserId String
  createdBy       User   @relation("ExerciseCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutExercises WorkoutExercise[]

  @@index([isActive])
  @@map("exercises")
}

enum WorkoutPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// A trainer's program for one assigned member. Unlike Membership/Payment,
// this has no snapshot fields — a workout plan isn't a purchase with
// terms that must survive a later price change, it's a living document
// the trainer is expected to keep current for as long as it's ACTIVE.
model WorkoutPlan {
  id          String  @id @default(cuid())
  name        String
  description String?

  memberId String
  member   User   @relation("MemberWorkoutPlans", fields: [memberId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User   @relation("TrainerWorkoutPlans", fields: [trainerId], references: [id], onDelete: Cascade)

  startDate DateTime  @default(now())
  endDate   DateTime?
  status    WorkoutPlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days WorkoutDay[]

  @@index([memberId, status])
  @@index([trainerId])
  @@map("workout_plans")
}

// One training day within a plan (e.g. "Monday" or "Push Day" — a free-
// text label, not a fixed weekday enum, since plenty of real programs are
// organized by muscle group/session type rather than calendar day).
model WorkoutDay {
  id     String @id @default(cuid())
  planId String
  plan   WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  label      String
  orderIndex Int     @default(0)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises WorkoutExercise[]

  @@index([planId])
  @@map("workout_days")
}

// One exercise prescribed within a workout day, with the sets/reps/
// weight/rest actually assigned — distinct from Exercise, which is just
// the catalog entry ("Bench Press" exists once; how heavy a given member
// lifts it is per-plan, per-day data). weightKg is a plain float, unlike
// money's integer-minor-units rule: it's a measurement a trainer/member
// eyeballs and edits by hand, never summed or compared for equality the
// way currency is, so float rounding isn't a real risk here.
model WorkoutExercise {
  id           String     @id @default(cuid())
  workoutDayId String
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  orderIndex  Int     @default(0)
  sets        Int
  reps        Int
  weightKg    Float?
  restSeconds Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutDayId])
  @@map("workout_exercises")
}

// What "metric" means for a ProgressLog row. A closed set, deliberately —
// "do not collect unnecessary health information" means no freeform
// medical-history fields; CUSTOM is the one escape hatch for something a
// trainer/member wants to track that isn't in this list (e.g. resting
// heart rate), carrying a short label rather than opening up arbitrary
// health data collection.
enum ProgressMetric {
  WEIGHT_KG
  BODY_FAT_PERCENT
  CHEST_CM
  WAIST_CM
  HIPS_CM
  ARM_CM
  THIGH_CM
  CUSTOM
}

// Append-only by convention (like Payment/Attendance): a measurement
// taken on a date is a historical fact, corrected by logging a new entry
// with accurate notes, not by editing the old one out from under a
// progress chart. Always self-recorded by the member today (see
// progress.service.ts) — recordedByUserId exists for the same audit-
// trail reason Payment.recordedByUserId does, ready for a future
// trainer-assisted recording feature without a schema change.
model ProgressLog {
  id String @id @default(cuid())

  memberId String
  member   User   @relation("MemberProgressLogs", fields: [memberId], references: [id], onDelete: Cascade)

  recordedAt  DateTime       @default(now())
  metric      ProgressMetric
  // Only meaningful (and required, at the validation layer) when
  // metric = CUSTOM — the other values are already self-describing.
  customLabel String?
  value       Float
  notes       String?

  recordedByUserId String
  recordedBy       User   @relation("ProgressLogRecordedBy", fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, recordedAt])
  @@map("progress_logs")
}

// What kind of event a Notification is about. A closed set, deliberately
// small — every value here corresponds to exactly one call site that
// creates it (see notification.service.ts and the "How notifications
// work" README section), not a generic free-text category a caller could
// misuse to spam a user with ad-hoc messages.
enum NotificationType {
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  PAYMENT_RECORDED
  WORKOUT_PLAN_ASSIGNED
  TRAINER_ASSIGNED
}

// In-app only — there is no email/push delivery yet (see
// notification.service.ts's comment on why, and the README's "How
// notifications work" section). A row here is the single source of
// truth for "was this user told about this," so a future email channel
// would read from this table rather than duplicating its own history.
model Notification {
  id String @id @default(cuid())

  recipientUserId String
  recipient       User   @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Deep link into the app (e.g. "/member/workout-plans/abc123") shown as
  // an "Open" action if present. Nullable — a purely informational
  // notification (e.g. "you were assigned a new trainer," which has no
  // dedicated page to link to yet) has none.
  linkUrl String?

  // The id of whatever row this notification is about — a Membership,
  // Payment, WorkoutPlan, or TrainerAssignment id, depending on `type`.
  // Used only for the dedup check in notification.service.ts's
  // createNotificationOnce (e.g. "don't create a second 'expiring soon'
  // notification for the same membership"), never joined against
  // directly, since which table it refers to varies by type.
  relatedEntityId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([recipientUserId, isRead])
  @@index([recipientUserId, createdAt])
  @@map("notifications")
}
