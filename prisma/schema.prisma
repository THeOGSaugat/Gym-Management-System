// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAINER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// One table for every role. Login is identical regardless of role, so a
// single table avoids three separate login paths. Role-specific profile
// data (MemberProfile, TrainerProfile) is added in Phase 2.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}
